#!/bin/sh

if [ -n "${TMUX:-}" ]; then
    echo "Already inside tmux (nesting prevented). Current session: $TMUX" >&2
    exit 0
fi

case $(command -v tmux 2>/dev/null) in
  *nix*)
    export TMUX_TMPDIR="${TMPDIR:-/tmp}/tmux-${UID:-$(id -u)}-nix"
	  mkdir -p -m 700 "$TMUX_TMPDIR"
	  ;;
esac

into() {
  set -x
  exec "$@"
}

if tmux has-session 2>/dev/null; then
    into tmux attach-session -d
else
    into tmux new-session -s tmux -c "$HOME"
fi
