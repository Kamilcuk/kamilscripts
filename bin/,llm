#!/bin/bash
set -euo pipefail

. L_lib.sh -s

makefile() {
    local path=$1
    if mkdir -p "$(dirname -- "$path")"; then
        touch "$path"
    fi
}

bwrap_sandbox() {
    if ((arg_podman && arg_docker)); then
        L_fatal "--podman and --docker are mutually exclusive"
    fi
    local cachedir="${XDG_CACHE_HOME:-$HOME/.cache}/,llm"
    local root="$cachedir/root"
    local empty="$cachedir/empty"
    mkdir -p "$root"/{var,mnt,srv,media,root} "$empty"
    #
    local args=(
        bwrap
        --bind "$cachedir"/root /
        --clearenv
        --setenv KCLLM 1
        --unshare-all
        --share-net
        --die-with-parent
        --bind "$PWD" "$PWD"
        --chdir "$PWD"
        --tmpfs /tmp
        --proc /proc
        --dev /dev
    )
    add() { args+=("$@"); }
    addpath() {
        local i
        for i in "${@:2}"; do
            if [[ -e "$i" ]]; then
                args+=("$1" "$i" "$i")
            fi
        done
    }
    local config=${XDG_CONFIG_HOME:-$HOME/.config}
    local cache=${XDG_CACHE_HOME:-$HOME/.cache}
    local data=${XDG_DATA_HOME:-$HOME/.local/share}
    local state=${XDG_STATE_HOME:-$HOME/.local/state}
    # basic directories we need.
    addpath --ro-bind /bin /sbin /lib /lib64 /usr /etc /run /opt
    for i in /var /mnt /srv /media /root; do
        add --ro-bind "$empty" "$i"
    done
    # cache list to consider
    addpath --bind "$cache/uv" "$cache/getstuffcli"
    addpath --bind "$data"
    addpath --bind "$cache/pip"
    addpath --bind "$cache/npm" "$cache/pnpm" "$cache/yarn"
    addpath --bind "$cache/poetry" "$cache/maturin" "$cache/go-build"
    addpath --bind "$HOME/.npm" "$HOME/.node_modules"
    addpath --ro-bind "$config/yarn" "$config/npm"
    addpath --bind "$HOME/.cargo" "$HOME/.rustup"
    addpath --ro-bind "$HOME/.gitconfig" "$config/git/config"
    addpath --ro-bind /opt /snap "$HOME/snap"
    addpath --ro-bind /nix "$state"/nix "$HOME"/.nix-profile "$HOME"/.nix-defexpr
    addpath --ro-bind "$HOME"/.local/bin
    addpath --bind "$HOME/.platformio"
    addpath --bind "$cache"/ms-playwright
    addpath --ro-bind ~/.kamilscripts/bin
    addpath --bind "$HOME/.config/gcloud"
    # /nix/var/nix/daemon-socket
    addpath --bind "$HOME/.dotnet" "$HOME/.nuget"
    if [[ -L /etc/resolv.conf ]]; then
        local tmp
        tmp="$(readlink -f /etc/resolv.conf)"
        addpath --ro-bind "$tmp"
    fi
    # gemini, crush, opencode configuration directories.
    for i in gemini crush opencode claude; do
        addpath --bind "$cache/$i" "$config/$i" "$HOME/.$i"
    done
    # DBus Session Bus.
    if [[ "${DBUS_SESSION_BUS_ADDRESS:-}" =~ unix:path=([^,]+) ]]; then
        local dbus_socket="${BASH_REMATCH[1]}"
        if [[ -S "$dbus_socket" ]]; then
            addpath --ro-bind "$dbus_socket"
        fi
    fi
    # Docker.
    if ((arg_docker)); then
        if [[ -e /var/run/docker.sock ]]; then
            L_debug "Using docker..."
            addpath --bind /var/run/docker.sock
        else
            L_fatal "Docker socket /var/run/docker.sock not found"
        fi
    fi
    # Podman.
    if ((arg_podman)); then
        if [[ -e /usr/bin/docker ]] && [[ -e /usr/bin/podman ]] && /usr/bin/podman --version >/dev/null 2>/dev/null; then
            L_debug "Using podman..."
            # Fix for podman in read-only /run/user/1000 or missing cgroups
            if [[ ! -w "/run/user/${UID:-$(id -u)}" ]] || [[ ! -d /sys/fs/cgroup ]]; then
                export XDG_RUNTIME_DIR="/tmp/podman-run-${UID:-$(id -u)}"
                mkdir -p "$XDG_RUNTIME_DIR"
                # Force podman to ignore cgroups and events if they are missing/broken
                export CONTAINERS_CONF_OVERRIDE_ENGINE_CGROUP_MANAGER="none"
                export CONTAINERS_CONF_OVERRIDE_ENGINE_EVENTS_LOGGER="none"
            fi
            # Apply fix for read-only /run/user or missing cgroups.
            add --tmpfs "/run/user/$UID"
            add --setenv XDG_RUNTIME_DIR "/run/user/$UID"
            add --setenv CONTAINERS_CONF_OVERRIDE_ENGINE_CGROUP_MANAGER "none"
            add --setenv CONTAINERS_CONF_OVERRIDE_ENGINE_EVENTS_LOGGER "none"
            # Start podman service sock.
            if [[ ! -e /run/user/$UID/podman/podman.sock ]] && L_hash systemctl; then
                L_logrun systemctl start --user podman.service
            fi
            # Add environment variables.
            add --setenv CONTAINER_RUNTIME podman
            add --setenv DOCKER_BIN podman
            # Set the podman socket. the socket.
            if [[ -d /run/user/$UID/podman ]]; then
                add --ro-bind /run/user/$UID/podman /run/user/$UID/podman
            fi
            add --setenv DOCKER_HOST unix:///run/user/$UID/podman/podman.sock
            # Create /llmbin directory with podman wrapper that will explicitly pass --url.
            local fd
            exec {fd}< <(printf "%s\n" '#!/bin/bash' 'exec /usr/bin/podman --url "${DOCKER_HOST:-unix:///run/user/$UID/podman/podman.sock}" "$@"')
            add --perms 555 --file "$fd" /llmbin/podman --symlink /llmbin/podman /llmbin/docker
            export PATH="/llmbin:$PATH"
        else
            L_fatal "Podman not detected"
        fi
    fi
    if false; then
        # Add bash history
        # Don't add - it is security issue.
        for i in "$HOME/.bash_history"; do
            makefile "$root/$i"
            add --bind "$root/$i" "$i"
        done
        if [[ -n "${HISTFILE:-}" && -e "$HISTFILE" && "$HISTFILE" != "$HOME/.bash_history" ]]; then
            makefile "$root/$HISTFILE"
            add --bind "$root/$HISTFILE" "$HISTFILE"
        fi
    fi
    if (( !arg_no_hide )); then
        local hiderfile=${TMPDIR:-/tmp}/,llm_hider
        echo "**This file is hidden from LLM by sandbox**" > "$hiderfile"
        declare -A once=()
        # Hide
        shopt -s globstar nullglob extglob
        for i in "$PWD"/{,**/}{env*,.env*,secrets*,*.pem,*.key,*.crt} "${arg_hide[@]}"; do
            if [[ -e "$i" && "$i" != .env.example ]]; then
                i=$(readlink -f "$i")
                if [[ ! -v once["$i"] ]]; then
                    L_debug "Hiding $i"
                    add --ro-bind "$hiderfile" "$i"
                    once["$i"]="done"
                fi
            fi
        done
    fi
    # Add args
    local i p
    for i in "${arg_ro[@]}"; do
        p=$i; [[ $p == /* ]] || p=$PWD/$p
        addpath --ro-bind "$p"
    done
    for i in "${arg_rw[@]}"; do
        p=$i; [[ $p == /* ]] || p=$PWD/$p
        addpath --bind "$p"
    done
    if ((0)); then
        local i abs_i abs_pwd is_undef
        for i in "${arg_rw[@]}"; do
            abs_i=$(realpath "$i")
            abs_pwd=$(realpath "$PWD")
            if [[ "$abs_pwd" == "$abs_i"* ]]; then
                echo "$abs_pwd is under $abs_i"
            fi
        done
    fi
    # Git root mount
    if (( !arg_no_git )); then
        if set_git_root; then
            L_debug "Mounting git root $git_root --rw"
            addpath --bind "$git_root"
        fi
    fi
    # Whitelist environment variables.
    local env_whitelist=(
        PATH HOME USER LOGNAME SHELL TERM COLORTERM PWD TMPDIR
        LANG LC_ALL LC_CTYPE LC_MESSAGES
        HTTP_PROXY HTTPS_PROXY NO_PROXY
        XDG_CONFIG_HOME XDG_CACHE_HOME XDG_DATA_HOME XDG_STATE_HOME
        XDG_RUNTIME_DIR CONTAINERS_CONF
        CONTAINERS_CONF_OVERRIDE_ENGINE_CGROUP_MANAGER
        CONTAINERS_CONF_OVERRIDE_ENGINE_EVENTS_LOGGER
        PYTHONPATH VIRTUAL_ENV NVM_DIR NODE_PATH
        GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
        EDITOR VISUAL BROWSER
        DBUS_SESSION_BUS_ADDRESS
    )
    for i in "${env_whitelist[@]}"; do
        if [[ -v "$i" ]]; then
            add --setenv "$i" "${!i}"
        fi
    done
    # Add environment variables from -e/--env
    for i in "${arg_env[@]:-}"; do
        if [[ "$i" == *"="* ]]; then
            add --setenv "${i%%=*}" "${i#*=}"
        elif [[ "$i" == *"*"* ]]; then
            # Wildcard support
            for var in $(compgen -v); do
                if [[ "$var" == $i ]]; then
                    add --setenv "$var" "${!var}"
                fi
            done
        else
            if [[ -v "$i" ]]; then
                add --setenv "$i" "${!i}"
            fi
        fi
    done
    #
    if ((arg_verbose)); then
        set -x
    fi
    args+=("$@")
    if (( arg_dryrun )); then
        printf -v L_v " %q" "${args[@]}"
        echo "+$L_v"
    else
        exec "${args[@]}"
    fi
}

add_ro_if_not_there() {
    if ! L_args_contain ~/.node_modules "${arg_ro[@]}" "${arg_rw[@]}"; then
        arg_ro+=(~/.node_modules)
    fi
}

patch_gemini_bundles() {
    local bundle_dir="/home/kamil/.node_modules/lib/node_modules/@google/gemini-cli/bundle"
    [[ -d "$bundle_dir" ]] || return 1

    local todos_pattern='this.useWriteTodos = .* : false;'
    local todos_replacement='this.useWriteTodos = true;'
    grep -l "$todos_pattern" "$bundle_dir"/chunk-*.js | while read -r target_file; do
        echo "PATCHING useWriteTodos: $target_file"
        sed -i "s@$todos_pattern@$todos_replacement@g" "$target_file"
    done

    local label_pattern='const label = terminalWidth < MIN_TERMINAL_WIDTH_FOR_FULL_LABEL ? "%" : "% used";'
    local label_replacement='const label = " tokens";'
    local perc_pattern='const percentageUsed = (percentage \* 100).toFixed(0);'
    local perc_replacement='const percentageUsed = promptTokenCount > 1000 ? (promptTokenCount / 1000).toFixed(1) + "k" : promptTokenCount;'

    grep -l "$label_pattern" "$bundle_dir"/chunk-*.js | while read -r target_file; do
        echo "PATCHING ContextUsageDisplay: $target_file"
        sed -i "s@$perc_pattern@$perc_replacement@g" "$target_file"
        sed -i "s@$label_pattern@$label_replacement@g" "$target_file"
    done
}

C_gemini-patch() {
    patch_gemini_bundles
}

C_my() {
    # export GOOGLE_GEMINI_BASE_URL=http://192.168.40.1:8990/gemini
    # export GOOGLE_GEMINI_BASE_URL=https://gemini.kamcuk.top/gemini
    # L_info "GOOGLE_GEMINI_BASE_URL=$GOOGLE_GEMINI_BASE_URL"
    # C_gemini --model gemini-3-my "$@"
    C_claude "$@"
}

C_claude() {
    arg_env+=("ANTHROPIC_*" "CLAUDE_*")
    bwrap_sandbox claude "$@"
}

set_git_root() {
    git_root=$(git rev-parse --show-toplevel 2>/dev/null)
}
L_decorate L_cache -s git_root set_git_root

C_gemini() {
    C_gemini-patch
    if [[ $(which gemini) == ~/.node_modules/bin/gemini ]]; then
        add_ro_if_not_there ~/.node_modules
    fi
    arg_env+=("GEMINI*" "GOOGLE*")
    local cmd=(
        env GEMINI_TIMEOUT=999999
        gemini --yolo
    )
    # Add git mount to gemini workspace
    if (( !arg_no_git )); then
        if set_git_root; then
            cmd+=(--include-directories "$git_root")
        fi
    fi
    bwrap_sandbox "${cmd[@]}" "$@"
}

C_v() {
    export GOOGLE_GEMINI_BASE_URL=https://gemini.kamcuk.top/vertex
    L_info "GOOGLE_GEMINI_BASE_URL=$GOOGLE_GEMINI_BASE_URL"
    C_gemini --model gemini-3-my "$@"
}

C_bwrap() {
    if ((!$#)); then
        set -- bash -l
    fi
    bwrap_sandbox "$@"
}
C_env() { C_bwrap env "$@"; }
C_sandbox() { C_bwrap "$@"; }
C_bash() { C_bwrap bash "$@"; }
C_crush() {
    if [[ "$(which crush)" == ~/go/bin/crush ]]; then
        add_ro_if_not_there ~/go
    fi
    C_bwrap crush --yolo "$@"
}
C_opencode() { C_bwrap opencode --agent yolo "$@"; }

pick_key() {
    local idx=$1
    if [[ idx == 0 ]]; then
        return
    fi
    # local -;set -x
    if [[ -n "${GEMINI_GEMINI_API_KEYS:-}" ]]; then
        GEMINI_API_KEYS=${GEMINI_API_KEYS:-$GEMINI_GEMINI_API_KEYS}
    fi
    if [[ -n "${GEMINI_API_KEYS:-}" ]]; then
        local keys
        IFS=, read -ra keys <<<"$GEMINI_API_KEYS"
        if [[ -v keys[idx] ]] ; then
            local v=keys[idx]
            export GEMINI_API_KEY=${keys[idx]}
            L_notice "GEMINI_API_KEY=...${GEMINI_API_KEY:${#GEMINI_API_KEY}-6} from GEMINI_API_KEYS[$idx]"
        else
            L_warning "--key argument invalid, variable does not exist: $idx in GEMINI_API_KEYS which has ${#keys[@]} keys"
            return
        fi
    # else
    #     local v=GEMINI_API_KEY$idx
    #     if [[ -v $v ]]; then
    #         export GEMINI_API_KEY=${!v}
    #         L_notice "GEMINI_API_KEY=...${GEMINI_API_KEY:${#GEMINI_API_KEY}-6} idx=$idx"
    #     else
    #         L_warning "--key argument invalid, variable does not exist: $v"
    #     fi
    fi
    L_debug "+ export GEMINI_API_KEY=\$$v"
}

C_c() {
    # export ANTHROPIC_BASE_URL=http://192.168.40.1:8990/geminiopenai/
    # export ANTHROPIC_BASE_URL=http://192.168.40.1:8990/mistralai
    export ANTHROPIC_BASE_URL=http://192.168.40.1:3456
    export ANTHROPIC_MODEL=my
    arg_env+=("ANTHROPIC*")
    bwrap_sandbox claude "$@"
}

arg_verbose=0
L_argparse dest_prefix=arg_ \
    -- -q --quiet nargs=0 eval='((arg_verbose--)); L_log_level_dec' \
    -- -v --verbose nargs=0 eval='((arg_verbose++)); L_log_level_inc' \
    -- -o --ro action=append default= help="List of directories or file to mount read only" \
    -- -w --rw --bind action=append default= help="List of directories or files to mount read write" \
    -- --hide action=append default= help="Hide specific files from the llm by mounting /dev/null on top of them" \
    -- -H --no-hide flag=1 help="Ignore all --hide" \
    -- -k --key default= nargs=1 eval='pick_key "$@"' \
    -- -p --podman flag=1 \
    -- -d --docker flag=1 \
    -- -G --no-git flag=1 \
    -- -e --env action=append default= help="Set environment variable in the sandbox" \
    -- -n --dryrun flag=1 \
    -- call=function prefix=C_ \
    ---- "$@"

